{
  "type": "module",
  "name": "@veyyon/tool",
  "version": "1.4.0",
  "description": "What a tool states about itself and what it returns: spec, approval tier, result and streaming update",
  "homepage": "https://veyyon.dev",
  "author": "santhreal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santhreal/veyyon.git",
    "directory": "contracts/tool"
  },
  "bugs": {
    "url": "https://github.com/santhreal/veyyon/issues"
  },
  "keywords": [
    "tool",
    "contract",
    "types",
    "llm"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "check": "biome check . && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write .",
    "test": "bun test --parallel"
  },
  "dependencies": {
    "@veyyon/model": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./*.js": "./src/*.ts"
  }
}
