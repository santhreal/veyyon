{
	"type": "module",
	"private": true,
	"name": "@veyyon/bench",
	"version": "0.1.0",
	"description": "Benchmark, eval and simulation harnesses: DeepSWE runner, Harbor run storage and dashboard, deterministic simulations, TypeScript edit benchmark (see README.md)",
	"homepage": "https://veyyon.dev",
	"author": "santhreal",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/santhreal/veyyon.git",
		"directory": "packages/bench"
	},
	"bugs": {
		"url": "https://github.com/santhreal/veyyon/issues"
	},
	"bin": {
		"metaharness": "src/metaharness/server.ts"
	},
	"scripts": {
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit && tsgo -p src/metaharness/web/tsconfig.json --noEmit",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write .",
		"test": "bun test",
		"bench": "bun src/deepswe/run.ts",
		"bench:pier": "python3 -m unittest discover -s src/deepswe/pier_agent -p '*_test.py'",
		"serve": "bun run src/metaharness/server.ts",
		"dev": "bun --hot src/metaharness/server.ts",
		"generate": "bun run src/typescript-edit/generate.ts --typescript-dir /tmp/typescript-source --count-per-type 4"
	},
	"dependencies": {
		"@babel/generator": "catalog:",
		"@babel/parser": "catalog:",
		"@babel/traverse": "catalog:",
		"@babel/types": "catalog:",
		"@veyyon/agent-core": "catalog:",
		"@veyyon/ai": "catalog:",
		"@veyyon/catalog": "catalog:",
		"@veyyon/coding-agent": "catalog:",
		"@veyyon/hashline": "catalog:",
		"@veyyon/natives": "catalog:",
		"@veyyon/tui": "catalog:",
		"@veyyon/utils": "catalog:",
		"argot": "workspace:*",
		"arktype": "catalog:",
		"clsx": "^2.1.1",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"diff": "catalog:",
		"motion": "^12.15.0",
		"prettier": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"regexp-tree": "catalog:",
		"tailwind-merge": "^3.3.0"
	},
	"devDependencies": {
		"@types/babel__generator": "catalog:",
		"@types/babel__traverse": "catalog:",
		"@types/bun": "catalog:",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.7",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"react-refresh": "^0.18.0"
	},
	"engines": {
		"bun": ">=1.4.0"
	}
}
