{
  "type": "module",
  "name": "@veyyon/render-oracle",
  "version": "1.2.0",
  "description": "Terminal renderer defect oracle: drivers, frame capture, invariant guarantees, scenario generation and a replayable defect corpus",
  "homepage": "https://veyyon.dev",
  "author": "santhreal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santhreal/veyyon.git",
    "directory": "packages/render-oracle"
  },
  "bugs": {
    "url": "https://github.com/santhreal/veyyon/issues"
  },
  "keywords": [
    "terminal",
    "tui",
    "renderer",
    "oracle",
    "conformance",
    "fuzzing",
    "tmux",
    "typescript"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "check": "biome check . && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "test": "bun test --parallel test/**/*.test.ts",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write ."
  },
  "dependencies": {
    "@veyyon/natives": "catalog:",
    "@veyyon/tui": "catalog:",
    "@veyyon/utils": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  }
}
