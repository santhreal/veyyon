{
	"name": "@veyyon/evals",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Every model and agent evaluation in this repository: suites, harnesses, execution backends, run store, and dashboard.",
	"author": "santhreal",
	"license": "MIT",
	"bin": {
		"evals": "src/cli.ts",
		"evals-server": "src/server/main.ts"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		},
		"./*.js": "./src/*.ts"
	},
	"scripts": {
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit && tsgo -p src/web/tsconfig.json --noEmit",
		"lint": "biome lint .",
		"test": "bun test",
		"test:py": "python3 -m unittest discover -s agents -p '*_test.py'",
		"serve": "bun run src/server/main.ts",
		"dev": "bun --hot src/server/main.ts",
		"evals": "bun src/cli.ts",
		"list": "bun src/cli.ts --list",
		"bench:search": "bun src/benches/search/parity.ts",
		"bench:search:disclosure": "bun src/benches/search/disclosure.ts",
		"deepswe": "bun src/suites/deep-swe/run.ts",
		"deepswe:smoke": "bun src/suites/deep-swe/run.ts --tasks datasets/deep-swe/tasks/smoke.txt --arms baseline --jobs 1",
		"deepswe:smoke:dry": "bun src/suites/deep-swe/run.ts --tasks datasets/deep-swe/tasks/smoke.txt --arms baseline --dry-run",
		"deepswe:pilot": "bun src/suites/deep-swe/run.ts --tasks datasets/deep-swe/tasks/pilot-10.txt --arms baseline,full --jobs 2",
		"deepswe:compare": "bun src/suites/deep-swe/run.ts --arms veyyon,omp --model opencode-go/deepseek-v4-flash --tasks datasets/deep-swe/tasks/pilot-10.txt"
	},
	"dependencies": {
		"@babel/generator": "catalog:",
		"@babel/parser": "catalog:",
		"@babel/traverse": "catalog:",
		"@veyyon/natives": "catalog:",
		"@veyyon/agent-core": "catalog:",
		"@veyyon/ai": "catalog:",
		"@veyyon/catalog": "catalog:",
		"@veyyon/coding-agent": "catalog:",
		"@veyyon/hashline": "catalog:",
		"@veyyon/tui": "catalog:",
		"@veyyon/utils": "catalog:",
		"argot": "workspace:*",
		"clsx": "^2.1.1",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"diff": "catalog:",
		"motion": "^12.15.0",
		"prettier": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"regexp-tree": "catalog:",
		"tailwind-merge": "^3.3.0",
		"yaml": "catalog:"
	},
	"devDependencies": {
		"@types/babel__generator": "catalog:",
		"@types/babel__traverse": "catalog:",
		"@types/bun": "catalog:",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.7",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"react-refresh": "^0.18.0"
	}
}
