			"tags": ["positive"],
			"input": {
				"tool": { "name": "bash", "approval": "exec" },
				"args": {},
				"mode": "yolo",
				"userConfig": {}
			},
			"expect": { "policy": "allow", "tier": "exec", "override": false }
		},
		{
			"id": "approval-yolo-critical-still-prompts",
