			"input": {
				"tool": {
					"name": "bash",
					"approval": { "tier": "exec", "critical": true, "reason": "Destructive recursive delete" }
				},
				"args": {},
				"mode": "yolo",
				"userConfig": {}
			},
			"expect": {
				"policy": "prompt",
				"tier": "exec",
				"override": true,
				"reasonContains": "Destructive recursive delete"
			}
		},
