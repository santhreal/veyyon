{
	"cases": [
		{
			"id": "compact-args-empty",
			"contract": "Empty /compact args parse to an empty object",
			"surface": "parse-compact-args",
			"tags": [
				"boundary"
			],
			"input": {
				"args": ""
			},
			"expect": {}
		},
		{
			"id": "compact-args-soft",
			"contract": "The retired `soft` name is not a mode: it stays focus text and the user is told so",
			"surface": "parse-compact-args",
			"tags": [
				"regression",
				"adversarial"
			],
			"input": {
				"args": "soft"
			},
			"expect": {
				"instructions": "soft",
				"noticeContains": "`soft` is no longer a compaction mode"
			}
		},
		{
			"id": "compact-args-soft-focus",
			"contract": "A retired name in front of focus text leaves the text exactly as typed, plus the notice",
			"surface": "parse-compact-args",
			"tags": [
				"regression",
				"adversarial"
			],
			"input": {
				"args": "soft keep the auth bits"
			},
			"expect": {
				"instructions": "soft keep the auth bits",
				"noticeContains": "Use `/compact summary`"
			}
		},
		{
			"id": "compact-args-remote-case",
			"contract": "The retired `remote` name is recognized case-insensitively so the notice still fires",
			"surface": "parse-compact-args",
			"tags": [
				"regression",
				"boundary"
			],
			"input": {
				"args": "REMOTE"
			},
			"expect": {
				"instructions": "REMOTE",
				"noticeContains": "`remote` is no longer a compaction mode"
			}
		},
		{
			"id": "compact-args-unknown-as-instructions",
			"contract": "An unknown first token keeps the whole string as focus instructions",
			"surface": "parse-compact-args",
			"tags": [
				"adversarial",
				"regression"
			],
			"input": {
				"args": "focus on auth"
			},
			"expect": {
				"instructions": "focus on auth"
			}
		},
		{
			"id": "compact-args-whitespace-only",
			"contract": "Whitespace-only args parse like empty args",
			"surface": "parse-compact-args",
			"tags": [
				"boundary"
			],
			"input": {
				"args": "   \t  "
			},
			"expect": {}
		},
		{
			"id": "find-compact-mode-soft-trim",
			"contract": "A retired name resolves to no mode, however it is cased or padded",
			"surface": "find-compact-mode",
			"tags": [
				"regression",
				"negative"
			],
			"input": {
				"name": " Soft "
			},
			"expect": {
				"name": null
			}
		},
		{
			"id": "find-compact-mode-unknown",
			"contract": "An unknown compact mode name resolves to null",
			"surface": "find-compact-mode",
			"tags": [
				"negative"
			],
			"input": {
				"name": "nope"
			},
			"expect": {
				"name": null
			}
		},
		{
			"id": "find-compact-mode-summary-trim",
			"contract": "findCompactMode trims and lowercases a live mode name",
			"surface": "find-compact-mode",
			"tags": [
				"positive",
				"boundary"
			],
			"input": {
				"name": "  Summary "
			},
			"expect": {
				"name": "summary"
			}
		},
		{
			"id": "find-compact-mode-handoff",
			"contract": "handoff is not a compaction mode, so it resolves to nothing",
			"surface": "find-compact-mode",
			"tags": [
				"negative"
			],
			"input": {
				"name": "handoff"
			},
			"expect": {
				"name": null
			}
		},
		{
			"id": "compact-args-summary-focus",
			"contract": "A live mode plus focus text yields that mode and the text with the mode word removed",
			"surface": "parse-compact-args",
			"tags": [
				"positive"
			],
			"input": {
				"args": "summary keep the auth bits"
			},
			"expect": {
				"mode": "summary",
				"instructions": "keep the auth bits"
			}
		},
		{
			"id": "compact-args-handoff-lone",
			"contract": "A lone handoff token is refused with the command that performs the transfer, never read as focus text",
			"surface": "parse-compact-args",
			"tags": [
				"negative",
				"regression"
			],
			"input": {
				"args": "HANDOFF"
			},
			"expect": {
				"error": "`handoff` is not a compaction mode. Use `/handoff [focus instructions]` to transfer context to a new session."
			}
		},
		{
			"id": "compact-args-retired-word-not-leading",
			"contract": "A retired name that is not the leading token is ordinary focus text and fires no notice",
			"surface": "parse-compact-args",
			"tags": [
				"adversarial",
				"regression"
			],
			"input": {
				"args": "keep the soft dependency bounds"
			},
			"expect": {
				"instructions": "keep the soft dependency bounds"
			}
		}
	]
}
