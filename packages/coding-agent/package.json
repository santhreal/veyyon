{
  "type": "module",
  "name": "@veyyon/coding-agent",
  "version": "1.3.0",
  "description": "Coding agent CLI with read, bash, edit, write tools and session management",
  "homepage": "https://veyyon.dev",
  "author": "santhreal",
  "contributors": [
    "Mario Zechner"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santhreal/veyyon.git",
    "directory": "packages/coding-agent"
  },
  "bugs": {
    "url": "https://github.com/santhreal/veyyon/issues"
  },
  "keywords": [
    "coding-agent",
    "ai",
    "llm",
    "cli",
    "tui",
    "agent"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "veyyon": "src/cli.ts"
  },
  "scripts": {
    "build": "bun scripts/build-binary.ts",
    "check": "biome check . && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit && bun run check:types:examples",
    "check:types:examples": "tsgo -p tsconfig.examples.json --noEmit",
    "lint": "biome lint .",
    "test": "bun ../../scripts/ci-test-ts.ts coding-agent-heavy --full",
    "fix": "biome check --write --unsafe . && bun run format-prompts",
    "fmt": "biome format --write . && bun run format-prompts",
    "format-prompts": "bun scripts/format-prompts.ts",
    "gen:bundle": "bun scripts/bundle-dist.ts",
    "gen:mupdf": "bun scripts/embed-mupdf-wasm.ts --generate",
    "gen:mupdf:reset": "bun scripts/embed-mupdf-wasm.ts --reset",
    "gen:prompt-ids": "bun scripts/gen-prompt-ids.ts",
    "gen:native": "bun --cwd=../natives run gen:native",
    "gen:tool-views": "bun --cwd=../collab-web run gen:tool-views",
    "gen:native:reset": "bun --cwd=../natives run gen:native:reset",
    "prepack": "bun run gen:bundle",
    "bench:guard": "bun scripts/bench-guard.ts"
  },
