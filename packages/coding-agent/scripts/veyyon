#!/bin/sh
# Dev launcher for the veyyon CLI, installed by `bun run setup`.
#
# Problem it solves: Bun reads `bunfig.toml` from the *current working
# directory* at startup and evaluates its `preload` entries before running the
# script. A bun-shebang bin (what `bun link` creates for `src/cli.ts`)
# therefore inherits whatever `preload` the directory you happen to be in
# declares. Running `veyyon` inside an unrelated Bun project can execute — and
# crash on — that project's preload, e.g.
#   error: Cannot find module '@v12sh/utils/frontmatter' from '.../loader.ts'
#
# Bun only reads the *exact* cwd (it does not walk parents) and ignores
# `--config`/`BUN_BE_BUN` for this, so the fix is to launch Bun from an empty,
# bunfig-free directory and restore the real cwd inside the process via the
# preload shim alongside this file.
set -e

# Parent directory of $1, by parameter expansion rather than a `dirname` fork.
# This script resolves its own location before anything has checked PATH, and a
# `dirname` that is not on PATH used to yield an empty string that `cd ""`
# accepted without complaint, silently leaving scripts_dir pointing at the
# user's current directory and every path below it wrong.
dir_of() {
	case $1 in
	*/*)
		_d=${1%/*}
		[ -n "$_d" ] || _d=/
		printf '%s' "$_d"
		;;
	*) printf '.' ;;
	esac
}

# Resolve this script's real location even when invoked through a symlink
# (`$HOME/.bun/bin/veyyon` -> this file).
self=$0
while [ -L "$self" ]; do
	# `set -e` aborts on a failed assignment, so a missing `readlink` killed the
	# script here with a bare 127 and no message at all. Let it fail, then decide.
	link=""
	if link=$(readlink "$self" 2>/dev/null); then :; fi
	# An unreadable link means the resolution FAILED; continuing would build a
	# path out of an empty string and then report some unrelated file as missing.
	if [ -z "$link" ]; then
		echo "veyyon: cannot resolve the symlink at $self (is readlink on PATH?)" >&2
		exit 1
	fi
	case $link in
	/*) self=$link ;;
	*) self=$(dir_of "$self")/$link ;;
	esac
done
scripts_dir=$(CDPATH= cd -- "$(dir_of "$self")" && pwd -P)
cli=$scripts_dir/../src/cli.ts
preload=$scripts_dir/veyyon.ts
timing_preload=$scripts_dir/../../utils/src/module-timer.ts

# Everything below this point runs bun: the two self-heal steps and the exec
# itself. A source install is the one shape where bun has to be on PATH at RUN
# time, not just at install time, and it drops off routinely — a non-login shell
# that never sources the rc holding `~/.bun/bin`, a PATH edit, a bun uninstall.
# Without this check the user gets `exec: bun: not found` from a command they
# installed successfully, with nothing naming the cause or the fix.
if ! command -v bun >/dev/null 2>&1; then
	echo "veyyon: bun is not on PATH, and this is a source install that runs veyyon through bun." >&2
	echo "veyyon: install bun (https://bun.sh) and make sure ~/.bun/bin is on PATH, or reinstall the standalone binary: curl -fsSL https://get.veyyon.dev | sh" >&2
	exit 1
fi

# The checkout itself has to still be there. A source install puts a symlink on
# PATH pointing into the checkout; if that tree is moved or partly deleted the
# symlink still resolves to this script, which then hands bun a path to nothing.
if [ ! -f "$cli" ]; then
	echo "veyyon: the source checkout this command points at is incomplete ($cli is missing)." >&2
	echo "veyyon: restore the checkout and re-run 'bun run setup' in it, or install the standalone binary: curl -fsSL https://get.veyyon.dev | sh" >&2
	exit 1
fi

# Self-heal gitignored build artifacts a bare `git pull` leaves missing.
# tool-views.generated.js is resolved at module PARSE time (a `with
# {type:"text"}` import), so without it veyyon dies at boot, not at HTML
# export — every freshly pulled source checkout hit this until regenerated
# (2026-07-24). Regenerate here when absent; if that fails (deps not
# installed), fail closed with the exact fix instead of the raw resolve error.
tool_views=$scripts_dir/../src/export/html/tool-views.generated.js
if [ ! -f "$tool_views" ]; then
	echo "veyyon: regenerating missing build artifact (tool-views.generated.js)..." >&2
	if ! bun --cwd="$scripts_dir/../../collab-web" run gen:tool-views >&2; then
		echo "veyyon: could not regenerate it. Run: cd $scripts_dir/../../.. && bun install" >&2
		exit 1
	fi
fi

# The native addon is the other gitignored built artifact a fresh clone or a
# bare `git pull` leaves missing; without it veyyon dies at boot with a raw
# resolve dump. Cheap same-platform glob here; the ensure script (single owner
# of provisioning: prebuilt release download, then cargo build, then a
# fail-closed paragraph) runs only on a miss so normal boots pay one stat.
case "$(uname -s)" in
Darwin) native_plat=darwin ;;
*) native_plat=linux ;;
esac
case "$(uname -m)" in
arm64 | aarch64) native_arch=arm64 ;;
*) native_arch=x64 ;;
esac
native_dir=$scripts_dir/../../natives/native
if ! ls "$native_dir/veyyon_natives.$native_plat-$native_arch"*.node >/dev/null 2>&1; then
	if ! bun "$scripts_dir/../../natives/scripts/ensure-native.ts" >&2; then
		exit 1
	fi
fi

launch_dir=${VEYYON_DEV_LAUNCH_DIR:-${HOME}/.veyyon/.dev-cwd}
mkdir -p "$launch_dir"

VEYYON_LAUNCH_CWD=$PWD
export VEYYON_LAUNCH_CWD
cd "$launch_dir"
if [ -n "${VEYYON_TIMING:-}" ]; then
	exec bun --preload "$preload" --preload "$timing_preload" "$cli" "$@"
fi
exec bun --preload "$preload" "$cli" "$@"
