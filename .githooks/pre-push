#!/usr/bin/env bash
#
# Refuse to push a commit that does not typecheck.
#
# Why this exists: main has gone red from a pushed commit four separate times,
# every one of them a TypeScript error that `bun run check:ts` reports in well
# under a minute. The gate already runs in CI (.github/workflows/checks.yml),
# so the breakage was always found -- after the push, on every open PR at once,
# which is where a red base stops being one person's problem. The
# half-committed argot -> lexpack rename left 64 errors on main and every port
# PR inherited them, so no PR's own CI meant anything until it was fixed.
#
# It checks the COMMIT being pushed, not the working tree. That distinction is
# the whole design here: this repo's canonical tree is dirty essentially all the
# time, and a hook that typechecks uncommitted work would block pushes over
# half-finished files that are not going anywhere. Such a hook gets disabled
# within a day, which is worse than not having one. So each pushed sha is
# checked out into a throwaway worktree that shares the repo's node_modules,
# which costs about half a second to create and gives the same answer CI will.
#
# Bypass with `git push --no-verify`, or `VEYYON_SKIP_PREPUSH=1` to skip only
# this check.
set -euo pipefail

if [ "${VEYYON_SKIP_PREPUSH:-}" = "1" ]; then
	echo "pre-push: skipped via VEYYON_SKIP_PREPUSH=1" >&2
	exit 0
fi

# git feeds one `<local ref> <local sha> <remote ref> <remote sha>` line per ref.
# A deletion pushes the all-zero sha and carries no tree to check.
shas=""
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	case "${local_sha:-}" in
	"" | 0000000000000000000000000000000000000000) continue ;;
	esac
	case " $shas " in
	*" $local_sha "*) ;;
	*) shas="$shas $local_sha" ;;
	esac
done
[ -z "$shas" ] && exit 0

# Fail closed rather than waving the push through. A hook that silently does
# nothing when its tool is missing is worse than no hook, because everyone
# believes they are covered.
if ! command -v bun >/dev/null 2>&1; then
	echo "pre-push: bun is not on PATH, so the typecheck cannot run." >&2
	echo "          Install bun, or push with VEYYON_SKIP_PREPUSH=1 if you accept the risk." >&2
	exit 1
fi

repo_root=$(git rev-parse --show-toplevel)

# Give the throwaway checkout a node_modules WITHOUT dragging the dirty tree in.
#
# The obvious `ln -s "$repo_root/node_modules" "$checkout/node_modules"` is
# wrong, and wrong in the one way that defeats the entire hook. Workspace
# packages are linked as `node_modules/@veyyon/ai -> ../../packages/ai`, a
# RELATIVE link, and a relative link resolves against the directory it really
# lives in. Through a symlinked node_modules that is the main repo, so every
# cross-package import typechecked the WORKING TREE while the hook reported it
# was checking the commit. A half-finished edit in one package could fail the
# push, and a broken commit could pass it because the fix was sitting uncommitted
# on disk. That is worse than no hook: it reports a check it did not perform.
#
# So third-party packages are linked entry by entry (they are identical in both
# trees and reinstalling them would cost far more than the check itself), and the
# workspace links are rebuilt to point INSIDE the worktree.
link_node_modules() {
	src="$repo_root/node_modules"
	dst="$1/node_modules"
	[ -d "$src" ] || return 0
	mkdir -p "$dst"
	for entry in "$src"/* "$src"/.[!.]*; do
		[ -e "$entry" ] || continue
		name=${entry##*/}
		[ "$name" = "@veyyon" ] && continue
		ln -sfn "$entry" "$dst/$name"
	done
	[ -d "$src/@veyyon" ] || return 0
	mkdir -p "$dst/@veyyon"
	for entry in "$src/@veyyon"/*; do
		[ -e "$entry" ] || continue
		name=${entry##*/}
		target=$(readlink "$entry" 2>/dev/null || true)
		case "$target" in
		../../packages/*) ln -sfn "$1/${target#../../}" "$dst/@veyyon/$name" ;;
		*) ln -sfn "$entry" "$dst/@veyyon/$name" ;;
		esac
	done
}

checkout=""
cleanup() {
	[ -n "$checkout" ] && git -C "$repo_root" worktree remove --force "$checkout" >/dev/null 2>&1 || true
}
trap cleanup EXIT

for sha in $shas; do
	short=$(git rev-parse --short "$sha")
	checkout="${TMPDIR:-/tmp}/veyyon-prepush-$$-$short"
	rm -rf "$checkout"
	if ! git -C "$repo_root" worktree add -q --detach "$checkout" "$sha" 2>/dev/null; then
		echo "pre-push: could not check out $short to verify it." >&2
		echo "          Push with VEYYON_SKIP_PREPUSH=1 if you accept the risk." >&2
		exit 1
	fi
	link_node_modules "$checkout"

	echo "pre-push: typechecking $short (bypass: git push --no-verify)" >&2
	if ! (cd "$checkout" && bun run check:ts); then
		echo >&2
		echo "pre-push: REFUSED. Commit $short does not typecheck, and pushing it turns" >&2
		echo "          every open PR red against a broken base, not just this branch." >&2
		echo "          Fix the errors above, or bypass with: git push --no-verify" >&2
		exit 1
	fi
	cleanup
	checkout=""
done
