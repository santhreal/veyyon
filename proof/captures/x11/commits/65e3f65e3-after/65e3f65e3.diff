[32m+[m[32m                ["ffprobe", "-v", "error", "-select_streams", "v",[m
[32m+[m[32m                 "-show_entries", "stream=r_frame_rate", "-of", "csv=p=0", str(path)],[m
[32m+[m[32m                capture_output=True, text=True,[m
