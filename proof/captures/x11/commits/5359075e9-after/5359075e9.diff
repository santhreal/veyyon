[32m+[m		[32mcase "${primary_gitdir}/" in[m
[32m+[m			[32m"${HOST_HOME}"/*)[m
[32m+[m				[32mlog "the git directory ${primary_gitdir} is inside ${HOST_HOME}, so it stays out of the sandbox: git-dependent suites will see a tree that is not a repository"[m
[32m+[m				[32m;;[m
[32m+[m			[32m*)[m
[32m+[m				[32mSANDBOX_GITDIR="${primary_gitdir}"[m
[32m+[m				[32m;;[m
