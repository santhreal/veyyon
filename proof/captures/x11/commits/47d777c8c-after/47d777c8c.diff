[32m+[m[32m#!/usr/bin/env bash[m
[32m+[m[32m# A scrolled viewport travelling through the rows between.[m
[32m+[m[32m#[m
[32m+[m[32m# The surface is the plan review overlay, one of the two viewports in the[m
[32m+[m[32m# product that outlive a single render (the other is the fullscreen agent[m
[32m+[m[32m# transcript viewer, which only opens for an advisor or a collab guest and so[m
[32m+[m[32m# cannot be reached from a local scene at all).[m
[32m+[m[32m#[m
[32m+[m[32m# Nothing here waits for a model. The recorder is launched with `--continue`[m
[32m+[m[32m# against a session seeded into proof/docker/home-seed:[m
[32m+[m[32m#[m
[32m+[m[32m#   sessions/-demo/<stamp>_<id>.jsonl          header + a `mode_change` to plan[m
[32m+[m[32m#   sessions/-demo/<stamp>_<id>/local/…-plan.md  the plan this scene scrolls[m
[32m+[m[32m#[m
[32m+[m[32m# so the CLI comes up already in plan mode with a plan on disk, and[m
[32m+[m[32m# `/plan-review` opens the overlay on it. Every row the recording scrolls is[m
[32m+[m[32m# numbered in that file, which is what makes a frame taken mid-travel legible:[m
[32m+[m[32m# the strip either holds the rows between two readings or it does not.[m
[32m+[m[32m#[m
[32m+[m[32m#   SCENE_COMMAND="bun /repo/packages/coding-agent/src/cli.ts --continue \[m
[32m+[m[32m#     --model local/qwen2.5-1.5b" proof/docker/record-x11.sh proof/scenes/plan-scroll.sh[m
[32m+[m[32m#[m
[32m+[m[32m# No stills — `import` costs about fifteen seconds a frame on this display and[m
[32m+[m[32m# would stall the middle of a travel. The page's frames are cut out of the[m
[32m+[m[32m# recording afterwards.[m
[32m+[m
[32m+[m[32msettle 20[m
[32m+[m
[32m+[m[32m# --- open the review -------------------------------------------------------[m
[32m+[m[32m# Escape closes the command popup and leaves the draft alone, so Return submits[m
[32m+[m[32m# `/plan-review` rather than accepting whatever row the popup had selected.[m
[32m+[m[32mt "/plan-review"[m
[32m+[m[32mpause 1.2[m
[32m+[m[32mk Escape[m
[32m+[m[32mpause 0.6[m
[32m+[m[32mk Return[m
[32m+[m[32msettle 6[m
[32m+[m
[32m+[m[32m# --- one page down, alone --------------------------------------------------[m
[32m+[m[32m# The pointer is parked off the body first: a hover band under it would move[m
[32m+[m[32m# with the rows and muddy what the strip is measuring.[m
[32m+[m[32mpoint 2 120[m
[32m+[m[32mpause 1.5[m
[32m+[m[32mk Next[m
[32m+[m[32msleep 4[m
[32m+[m
[32m+[m[32m# --- a second page, so the strip has a repeat -------------------------------[m
[32m+[m[32mk Next[m
[32m+[m[32msleep 4[m
[32m+[m
[32m+[m[32m# --- the wheel, with a real pointer on the body -----------------------------[m
[32m+[m[32mpoint 18 60[m
[32m+[m[32mpause 1.0[m
[32m+[m[32mwheel_down 4[m
[32m+[m[32msleep 4[m
[32m+[m
[32m+[m[32m# --- back up ----------------------------------------------------------------[m
[32m+[m[32mk Prior[m
[32m+[m[32msleep 4[m
[32m+[m[32mk Prior[m
[32m+[m[32msleep 4[m
[32m+[m
[32m+[m[32m# --- home, which lands ------------------------------------------------------[m
[32m+[m[32m# Both ends land by design: a viewport that follows its own tail must never lag[m
[32m+[m[32m# behind it, and the same rule takes `g` straight to row one.[m
[32m+[m[32mt "g"[m
[32m+[m[32msleep 3[m
[32m+[m
[32m+[m[32m# --- out --------------------------------------------------------------------[m
[32m+[m[32mk Escape[m
[32m+[m[32msettle 4[m
