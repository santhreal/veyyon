[32m+[m[32mheld, deleted_by_branch = [], [][m
[32m+[m[32mfor line in changed:[m
[32m+[m[32m    if not line.strip():[m
[32m+[m[32m        continue[m
[32m+[m[32m    status, path = line.split("\t")[0], line.split("\t")[-1][m
[32m+[m[32m    if status.startswith("D"):[m
[32m+[m[32m        deleted_by_branch.append(path)[m
[32m+[m[32m    elif status.startswith("M") or status.startswith("R"):[m
