{
	"name": "@veyyon/evals",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Every model and agent evaluation in this repository: suites, harnesses, execution backends, run store, and dashboard.",
	"author": "santhreal",
	"license": "MIT",
	"bin": {
		"evals": "evals.ts"
	},
	"exports": {
		".": {
			"types": "./evals.ts",
			"import": "./evals.ts"
		},
		"./*": {
			"types": "./*.ts",
			"import": "./*.ts"
		},
		"./*.js": "./*.ts"
	},
	"scripts": {
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit && tsgo -p dashboard/tsconfig.json --noEmit",
		"lint": "biome lint .",
		"test": "bun test",
		"test:py": "python3 -m unittest discover -s agents -p '*_test.py'",
		"serve": "bun evals.ts serve",
		"dev": "bun --hot evals.ts serve",
		"evals": "bun evals.ts",
		"list": "bun evals.ts --list",
		"bench": "bun evals.ts bench",
		"measure": "bun evals.ts measure",
		"tool": "bun evals.ts tool"
	},
	"dependencies": {
		"@babel/generator": "catalog:",
		"@babel/parser": "catalog:",
		"@babel/traverse": "catalog:",
		"@veyyon/natives": "catalog:",
		"@veyyon/agent-core": "catalog:",
		"@veyyon/ai": "catalog:",
		"@veyyon/catalog": "catalog:",
		"@veyyon/coding-agent": "catalog:",
		"@veyyon/hashline": "catalog:",
		"@veyyon/tui": "catalog:",
		"@veyyon/utils": "catalog:",
		"argot": "workspace:*",
		"clsx": "^2.1.1",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"diff": "catalog:",
		"motion": "^12.15.0",
		"prettier": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"regexp-tree": "catalog:",
		"tailwind-merge": "^3.3.0",
		"yaml": "catalog:"
	},
	"devDependencies": {
		"@types/babel__generator": "catalog:",
		"@types/babel__traverse": "catalog:",
		"@types/bun": "catalog:",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.7",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"react-refresh": "^0.18.0"
	}
}
