+// a member defined this way is built on first read and cached on the module. It is not enumerable,
+// so a scope's export, resolutions and JSON skip it while unread, and its key set does not change
+// when it is read (veyyon patch)
+export const defineLazyMember = (module, alias, build) => {
+    Object.defineProperty(module, alias, {
+        configurable: true,
+        enumerable: false,
+        get() {
+            const value = build();
+            Object.defineProperty(module, alias, { value, enumerable: false });
+            return value;
+        }
+    });
+};
+// a scope's export binds every member before the scope resolves and then compiles them together; a
+// member bound after that, which only a lazy member is, is finalized (compiled) as it is bound
+// (veyyon patch)
+const bindMember = (value, $) => {
+    if (hasArkKind(value, "module"))
+        return bindModule(value, $);
+    const bound = $.bindReference(value);
+    return $.resolved && hasArkKind(bound, "root") ? $.finalize(bound) : bound;
+};
+export const bindModule = (module, $) => {
+    const bound = new RootModule(flatMorph(module, (alias, value) => [
+        alias,
+        bindMember(value, $)
+    ]));
+    // a lazy member stays lazy on the bound module and binds when it is first read (veyyon patch)
+    for (const alias of Object.getOwnPropertyNames(module)) {
+        if (Object.prototype.propertyIsEnumerable.call(module, alias))
+            continue;
+        defineLazyMember(bound, alias, () => bindMember(module[alias], $));
+    }
+    return bound;
+};
