#!/usr/bin/env bash
# Stubbed `node` for scripts/release-tests/release-sh.test.sh: records the call
# (including which Pages project) and applies the fixture's declared effect
# instead of building or deploying anything.
set -uo pipefail
printf 'node %s (VEYYON_PAGES_PROJECT=%s)\n' "$*" "${VEYYON_PAGES_PROJECT:-}" >>"$FIXTURE/actions.log"
case "${1:-}" in
website/deploy.mjs)
	if [ -f "$FIXTURE/site-deploy-effect" ]; then
		# shellcheck source=/dev/null
		. "$FIXTURE/site-deploy-effect"
	fi
	;;
esac
exit 0
