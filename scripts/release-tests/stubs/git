#!/usr/bin/env bash
# Stubbed `git` for scripts/release-tests/release-sh.test.sh.
#
# Answers only the questions release.sh asks, from the fixture world under
# $FIXTURE. Every invocation is appended to $FIXTURE/actions.log so a test can
# assert that no outward action happened.
set -uo pipefail

printf 'git %s\n' "$*" >>"$FIXTURE/actions.log"

case "$1" in
ls-remote)
	# `git ls-remote --tags origin <pattern>` and `git ls-remote origin refs/heads/main`
	pattern="${*: -1}"
	case "$pattern" in
	"refs/heads/main")
		[ -s "$FIXTURE/main-sha" ] || exit 0
		printf '%s\trefs/heads/main\n' "$(cat "$FIXTURE/main-sha")"
		exit 0
		;;
	esac
	[ -s "$FIXTURE/origin-tags" ] || exit 0
	while IFS=' ' read -r tag sha; do
		[ -n "$tag" ] || continue
		case "$pattern" in
		'refs/tags/v*') printf '%s\trefs/tags/%s\n' "$sha" "$tag" ;;
		"refs/tags/$tag") printf '%s\trefs/tags/%s\n' "$sha" "$tag" ;;
		esac
	done <"$FIXTURE/origin-tags"
	exit 0
	;;
push)
	# The only mutating git call release.sh makes: deleting an unreleased tag.
	if [[ "${3:-}" == :refs/tags/* ]]; then
		doomed="${3#:refs/tags/}"
		tmp="$FIXTURE/origin-tags.tmp"
		: >"$tmp"
		while IFS=' ' read -r tag sha; do
			[ "$tag" = "$doomed" ] || printf '%s %s\n' "$tag" "$sha" >>"$tmp"
		done <"$FIXTURE/origin-tags"
		mv "$tmp" "$FIXTURE/origin-tags"
		exit 0
	fi
	exit 1
	;;
status) cat "$FIXTURE/git-status" 2>/dev/null || true; exit 0 ;;
rev-parse)
	case "${2:-}" in
	--abbrev-ref) cat "$FIXTURE/branch" 2>/dev/null || printf 'main\n' ;;
	*) cat "$FIXTURE/main-sha" 2>/dev/null || printf 'deadbeef\n' ;;
	esac
	exit 0
	;;
fetch) exit 0 ;;
esac
exit 0
