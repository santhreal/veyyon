{
  "type": "module",
  "name": "@veyyon/web",
  "version": "1.3.0",
  "description": "Site scrapers that turn a URL into markdown for Veyyon agents",
  "homepage": "https://veyyon.dev",
  "author": "santhreal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santhreal/veyyon.git",
    "directory": "plugins/web"
  },
  "bugs": {
    "url": "https://github.com/santhreal/veyyon/issues"
  },
  "keywords": [
    "scraper",
    "markdown",
    "fetch",
    "agent"
  ],
  "main": "./src/scrapers/index.ts",
  "module": "./src/scrapers/index.ts",
  "types": "./src/scrapers/index.ts",
  "scripts": {
    "check": "biome check . && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "test": "bun test --parallel",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write ."
  },
  "dependencies": {
    "@veyyon/ai": "catalog:",
    "@veyyon/utils": "catalog:",
    "linkedom": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/turndown": "catalog:",
    "turndown": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./src/scrapers/index.ts",
      "import": "./src/scrapers/index.ts"
    },
    "./scrapers": {
      "types": "./src/scrapers/index.ts",
      "import": "./src/scrapers/index.ts"
    },
    "./scrapers/*": {
      "types": "./src/scrapers/*.ts",
      "import": "./src/scrapers/*.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./*.js": "./src/*.ts"
  }
}
