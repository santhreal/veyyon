# =============================================================================
#  veybot environment
# =============================================================================
#
# This file is read in two distinct ways and you MUST keep that in mind when
# filling it in:
#
#   1. `docker compose` interpolates `${VAR}` references in docker-compose.yml.
#      The compose file uses per-service explicit `environment:` allowlists
#      (NO `env_file:`), so only the keys listed in each service's block flow
#      into the corresponding container — never the whole .env.
#
#   2. The Python `Settings` loader (`src/config.py`) also reads `.env`
#      for any local CLI invocation (e.g. `python -m veybot.cli triage …`
#      running on the host outside docker). `_validate_proxy_or_pat` fails
#      fast if BOTH a PAT and `VEYBOT_GH_PROXY_URL` are configured, so the
#      two modes below are mutually exclusive.
#
# Pick ONE of the two mode blocks below; leave the other fully commented out.
# Variables under "### shared ###" apply in either mode.


# =============================================================================
#  ### shared ### — required regardless of mode
# =============================================================================

# Shared HMAC secret used to verify webhook signatures. Must match the secret
# configured in the GitHub webhook UI / settings.
GITHUB_WEBHOOK_SECRET=

# GitHub login handle for the bot account whose PAT is in GITHUB_TOKEN (or
# whichever account the gh-proxy authenticates as). Prefer the lowercase bare
# mention handle (`veybot`, not `@veybot` or `veybot[bot]`); startup
# normalizes common forms, including uppercase and surrounding whitespace.
VEYBOT_BOT_LOGIN=

# Commit identity for branches the bot pushes. The email is what reviewers and
# GitHub will display next to the commit; pick one that matches how you want
# bot-authored commits to appear (a no-reply alias, a real address, etc.).
# `gh_push_branch` refuses to push unless every commit on the workspace branch
# carries this exact name + email.
VEYBOT_GIT_AUTHOR_NAME=
VEYBOT_GIT_AUTHOR_EMAIL=

# Comma-separated owner/repo entries the bot is allowed to act on.
VEYBOT_REPO_ALLOWLIST=

# Optional comma-separated GitHub logins whose @VEYBOT_BOT_LOGIN comments may
# authorize implementation work in addition to repo OWNER. Prefer lowercase
# bare logins; startup ignores leading `@`, case, whitespace, and `[bot]`.
VEYBOT_MAINTAINER_LOGINS=


# =============================================================================
#  ### gh-proxy mode (RECOMMENDED, default in docker compose) ###
#
#  The orchestrator NEVER holds the PAT; it talks to the sibling gh-proxy
#  container over an internal-only docker network, authenticated with a
#  shared HMAC key. Fill in BOTH variables below and leave the PAT mode
#  block fully commented out.
# =============================================================================

# Shared HMAC secret the orchestrator uses to authenticate every request to
# gh-proxy. The two containers MUST agree on this value. The proxy refuses
# any unsigned request; the orchestrator refuses to start without it.
# Generate with: openssl rand -hex 32
VEYBOT_GH_PROXY_HMAC_KEY=

# URL the orchestrator uses to reach gh-proxy. The default below matches the
# service name + port in docker-compose.yml; override only for local
# development outside compose (e.g. `http://127.0.0.1:8081`).
VEYBOT_GH_PROXY_URL=http://gh-proxy:8081

# PAT with `repo` (push, comment, PR) scope. A fine-grained token scoped to
# the allowlisted repos is recommended; a classic PAT also works.
#
# In gh-proxy mode this value lives ONLY in the gh-proxy container's
# environment (compose interpolates it into gh-proxy's allowlist only).
# Settings refuses to construct an orchestrator config that sees both
# GITHUB_TOKEN and VEYBOT_GH_PROXY_URL, so when running orchestrator code
# directly on the host (CLI, tests) you MUST keep GITHUB_TOKEN unset.
GITHUB_TOKEN=


# =============================================================================
#  ### PAT mode (single-process, no sidecar) ###
#
#  Drop the gh-proxy entirely and let the orchestrator hold the PAT directly.
#  To use this mode: uncomment GITHUB_TOKEN below, leave VEYBOT_GH_PROXY_URL
#  and VEYBOT_GH_PROXY_HMAC_KEY UNSET (above), and run the orchestrator
#  outside of the bundled docker-compose (which is wired for proxy mode).
# =============================================================================

# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# =============================================================================
#  --- Model selection ---
# =============================================================================
# Either a single model id or a comma-separated pool — veybot picks one
# uniformly at random per task. Use the `<provider>/<model>` form that matches
# your ~/.veyyon/agent/models.container.yml (which is mounted into the container as models.yml).
VEYBOT_MODEL=anthropic/claude-sonnet-4-6
# off|low|medium|high
VEYBOT_THINKING=high
# Optional provider override (passed to `veyyon --provider`).
# VEYBOT_PROVIDER=


# =============================================================================
#  --- Runtime ---
# =============================================================================
VEYBOT_MAX_CONCURRENCY=8
VEYBOT_TASK_TIMEOUT_SECONDS=2400
VEYBOT_TASK_TIMEOUT_HARD_GRACE_SECONDS=60
VEYBOT_REQUEST_TIMEOUT_SECONDS=120
# How many times an event is retried before it is parked as failed, and the
# delay before each retry. The delays are seconds, comma separated, and the
# last one repeats if retries outlive the list.
VEYBOT_EVENT_MAX_RETRIES=3
VEYBOT_EVENT_RETRY_DELAYS_SECONDS=30,120,600
# How many times a task that stops without reporting completion is reminded
# to finish before the run is abandoned.
VEYBOT_TASK_COMPLETION_MAX_REMINDERS=2
# On SIGTERM the dispatcher stops claiming new work, waits `DRAIN` seconds for
# in-flight events, then gives each surviving child `KILL` seconds to exit.
VEYBOT_SHUTDOWN_DRAIN_TIMEOUT_SECONDS=25
VEYBOT_SHUTDOWN_KILL_TIMEOUT_SECONDS=5


# =============================================================================
#  --- Triage, upstream ports, and CI repair ---
# =============================================================================
# When veybot picks up an issue. `label` is opt-in: nothing happens until the
# issue carries VEYBOT_TRIAGE_LABEL, so a busy tracker does not become a queue
# the moment the bot starts. Set `all` to triage every incoming issue.
VEYBOT_TRIAGE_TRIGGER=label
VEYBOT_TRIAGE_LABEL=veybot

# Porting merged upstream pull requests. An issue carrying VEYBOT_PORT_LABEL is
# treated as one port request: veybot prepares the change on a branch and opens
# a candidate pull request that closes the issue. It never merges, and it never
# pushes to your default branch.
VEYBOT_PORT_UPSTREAM_ENABLED=true
VEYBOT_PORT_LABEL=upstream-port

# Repairing a candidate pull request whose checks fail. veybot reads the failing
# check output and pushes a fix to the same branch, at most MAX_REPAIRS times
# per pull request, and it never weakens a test or a lint gate to go green.
VEYBOT_CI_REPAIR_ENABLED=true
VEYBOT_CI_MAX_REPAIRS=3

# Comma separated logins whose review comments are treated as bot noise rather
# than as maintainer instructions. Leave empty to trust every reviewer.
VEYBOT_REVIEWER_BOTS=


# =============================================================================
#  --- PR review ---
# =============================================================================
# veybot reviews incoming contributor PRs on opened/reopened/ready_for_review.
# Set VEYBOT_PR_REVIEW_ENABLED=false to disable veybot PR review entirely.
VEYBOT_PR_REVIEW_ENABLED=true


# =============================================================================
#  --- Per-submitter rate limiting ---
# =============================================================================
# Rolling window plus per-tier caps on queue-worthy submissions per
# GitHub login. Accounts whose webhook payload reports author_association
# OWNER/MEMBER/COLLABORATOR bypass the limiter automatically. Use the
# unlimited list (comma-separated logins, `@` optional) to whitelist
# additional users — e.g. yourself when developing outside the repo.
VEYBOT_RATE_LIMIT_WINDOW_SECONDS=3600
VEYBOT_RATE_LIMIT_DEFAULT=3
VEYBOT_RATE_LIMIT_CONTRIBUTOR=10
VEYBOT_RATE_LIMIT_UNLIMITED=


# =============================================================================
#  --- Question auto-close ---
# =============================================================================
# When the bot answers an issue classified as `question` it appends a
# 👎-to-keep-open prompt and schedules the issue to close as
# `state_reason=completed` after `HOURS`. Set `ENABLED=false` (or `HOURS=0`)
# to disable. Cancellation is automatic on a follow-up comment, an external
# close, or the issue author downvoting the bot's comment.
VEYBOT_QUESTION_AUTOCLOSE_ENABLED=true
VEYBOT_QUESTION_AUTOCLOSE_HOURS=4
# How often the scheduler scans for due rows. 60s is plenty given the
# multi-hour close window.
VEYBOT_QUESTION_AUTOCLOSE_SCAN_SECONDS=60

# Path or command name for the veyyon agent binary inside the container. The
# shipped image installs a shim that invokes Bun against the mounted veyyon checkout.
VEYBOT_AGENT_COMMAND=veyyon

# veyyon profile pinned for every agent subprocess, passed as `--profile`.
# Give veybot its own profile so its model, settings, and credentials stay
# separate from the one you work in. Leave empty to let veyyon pick its default.
VEYBOT_AGENT_PROFILE=veybot


# =============================================================================
#  --- Paths (inside the container) ---
# =============================================================================
VEYBOT_WORKSPACE_ROOT=/data/workspaces
VEYBOT_SQLITE_PATH=/data/veybot.sqlite
VEYBOT_LOG_DIR=/data/logs


# =============================================================================
#  --- Dev only ---
# =============================================================================
# Bind address for the webhook receiver.
VEYBOT_BIND_HOST=0.0.0.0
VEYBOT_BIND_PORT=8080

# Optional token enabling the POST /replay endpoint; leave blank to disable.
# VEYBOT_REPLAY_TOKEN=

# =============================================================================
#  --- veyyon source location (host side) ---
# =============================================================================
# veybot lives inside the veyyon monorepo at `python/veybot/`. `bun run
# veybot:build` builds the parent monorepo (`../..`) as its docker build
# context, and `docker-compose.yml` mounts that same path read-only at
# `/work/veyyon` inside the container. Override `VEYYON_ROOT` only if you want to point
# the build/mount at a different veyyon checkout.
# VEYYON_ROOT=../..


# =============================================================================
#  --- Question auto-close retries ---
# =============================================================================
# How many times a due auto-close is retried before it is given up on.
VEYBOT_QUESTION_AUTOCLOSE_MAX_RETRIES=5


# =============================================================================
#  --- gh-proxy listener (gh-proxy mode only) ---
# =============================================================================
# Where the gh-proxy sidecar listens, and the limits it enforces on what it
# will accept. The bind host is the container's own interface, so 0.0.0.0 is
# correct there: the proxy is reachable only on the internal docker network.
VEYBOT_GH_PROXY_BIND_HOST=0.0.0.0
VEYBOT_GH_PROXY_BIND_PORT=8081
VEYBOT_GH_PROXY_MAX_BODY_BYTES=1048576
VEYBOT_GH_PROXY_GIT_TIMEOUT_SECONDS=60


# =============================================================================
#  --- Native addon cache ---
# =============================================================================
# Each workspace would otherwise rebuild the veyyon native addon from source.
# The cache keeps built addons keyed by repository and revision, bounded by
# entries per repository and by total size, and collects garbage on an interval.
VEYBOT_NATIVES_CACHE_ENABLED=true
VEYBOT_NATIVES_CACHE_ROOT=/data/cache/veyyon-natives
VEYBOT_NATIVES_CACHE_MAX_ENTRIES_PER_REPO=8
VEYBOT_NATIVES_CACHE_MAX_BYTES=4294967296
VEYBOT_NATIVES_CACHE_GC_INTERVAL_SECONDS=3600
