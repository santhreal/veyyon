{
  "type": "module",
  "name": "@veyyon/kernel",
  "version": "1.3.0",
  "description": "The only Veyyon member that is not a plugin: it loads plugins, resolves their contributions and runs a session, and it names no tool and no host",
  "homepage": "https://veyyon.dev",
  "author": "santhreal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santhreal/veyyon.git",
    "directory": "kernel"
  },
  "bugs": {
    "url": "https://github.com/santhreal/veyyon/issues"
  },
  "keywords": [
    "kernel",
    "plugin",
    "loader",
    "registry",
    "session"
  ],
  "scripts": {
    "check": "biome check . && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write .",
    "test": "bun test --parallel"
  },
  "dependencies": {
    "@veyyon/agent-core": "catalog:",
    "@veyyon/ai": "catalog:",
    "@veyyon/catalog": "catalog:",
    "@veyyon/utils": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./loader/*": {
      "types": "./src/loader/*.ts",
      "import": "./src/loader/*.ts"
    },
    "./loader/*.js": "./src/loader/*.ts",
    "./registry/*": {
      "types": "./src/registry/*.ts",
      "import": "./src/registry/*.ts"
    },
    "./registry/*.js": "./src/registry/*.ts",
    "./session/*": {
      "types": "./src/session/*.ts",
      "import": "./src/session/*.ts"
    },
    "./session/*.js": "./src/session/*.ts"
  }
}
